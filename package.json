{
  "name": "redfirst",
  "version": "0.1.0",
  "description": "Makes your AI agent write tests that can fail. A skill, a linter and a gate for Playwright and Cypress suites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuiNunesBR/redfirst.git"
  },
  "author": "Guilherme Nunes Medeiros",
  "type": "module",
  "bin": {
    "redfirst": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skills",
    "playwright",
    "cypress",
    "test-automation",
    "qa",
    "sdet",
    "ai-agents",
    "linter"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "vitest": "^5.1.0"
  }
}
