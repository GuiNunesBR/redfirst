{
  "name": "playwright-serverest-e2e",
  "version": "1.0.0",
  "description": "Suíte de testes E2E e de API com Playwright + TypeScript contra o ServeRest (loja virtual para estudo de testes).",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^18.0.0",
    "zod": "^4.6.7"
  }
}
